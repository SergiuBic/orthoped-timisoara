# ── Copy to .env (root, used by docker compose) and web/.env.local (used by `pnpm dev`) ──

# Public origin. Local: http://localhost:3000   Prod: https://your-domain.ro
SITE_URL=http://localhost:3000
# Caddy: domain for automatic HTTPS (prod only). Leave empty locally.
DOMAIN=

# Postgres (container "db")
POSTGRES_USER=ortoped
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=ortoped
# Local dev (web on host):  postgres://ortoped:change-me-long-random@localhost:5432/ortoped
# In compose (web container): host is "db"
DATABASE_URL=postgres://ortoped:change-me-long-random@localhost:5432/ortoped

# Auth (better-auth + Google OAuth). Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${SITE_URL}/api/auth/callback/google
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=doctor@example.com,weakinsane@gmail.com

# AI – Google Gemini free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Shared secret for n8n <-> web internal endpoints (header x-internal-secret)
INTERNAL_SECRET=generate-with-openssl-rand-hex-32
# Where web calls n8n webhooks. Local: http://localhost:5678  Compose: http://n8n:5678
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
# Where n8n calls web. Compose: http://web:3000   (n8n in docker, web on host in dev: http://host.docker.internal:3000)
WEB_INTERNAL_URL=http://host.docker.internal:3000

# n8n
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
N8N_BASIC_USER=admin
N8N_BASIC_PASSWORD=change-me

# Analytics salt (rotate yearly)
ANALYTICS_SALT=generate-with-openssl-rand-hex-16

# Uploads (knowledge files + media). Compose mounts a volume here.
UPLOAD_DIR=./.data/uploads
